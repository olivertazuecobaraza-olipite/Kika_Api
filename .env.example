# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
# Puerto HTTP en el que escucha la API.
PORT=3000

# Entorno de ejecucion.
NODE_ENV=development

# Tamano maximo aceptado para el cuerpo JSON de las peticiones.
JSON_BODY_LIMIT=32kb

# -----------------------------------------------------------------------------
# Seguridad
# -----------------------------------------------------------------------------
# Modo de autenticacion:
# legacy: solo x-api-key; hybrid: JWT Bearer o x-api-key; jwt: solo JWT Bearer.
# Usa legacy al desplegar inicialmente y migra despues a hybrid y jwt.
AUTH_MODE=legacy

# Clave estatica de transicion. Es obligatoria en produccion con legacy o hybrid.
# Eliminala del entorno cuando AUTH_MODE sea jwt.
API_KEY=clave_estatica_solo_para_transicion

# Configuracion requerida cuando AUTH_MODE sea hybrid o jwt.
JWT_ISSUER=kika-token-service
JWT_AUDIENCE=kika-api

# Vida maxima aceptada para un token: 12 meses naturales, hasta 366 dias.
JWT_MAX_TTL_SECONDS=31622400

# Margen aceptado para pequenas diferencias de reloj entre sistemas.
JWT_CLOCK_TOLERANCE_SECONDS=30

# Mapa JSON kid -> clave publica PEM codificada en base64.
# Incluye temporalmente varias claves durante una rotacion.
JWT_PUBLIC_KEYS_JSON={"kika-2026-01":"<clave_publica_pem_codificada_en_base64>"}

# Incluye la IP en la auditoria solo si la politica de privacidad lo permite.
AUTH_AUDIT_INCLUDE_IP=false

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# URI de conexion a MongoDB. Esta variable es obligatoria.
MONGO_URI=mongodb://localhost:2017/tutor_db

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
# Clave de acceso a OpenAI. Esta variable es obligatoria.
OPENAI_API_KEY=tu_api_key_aqui

# Modelo usado para generar las respuestas del tutor.
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Modelo usado para convertir texto en vectores de busqueda.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Perplexity Sonar
# -----------------------------------------------------------------------------
# Clave opcional. Si no esta configurada, el tutor documental sigue disponible,
# pero las peticiones con busqueda web devuelven un error explicito.
PERPLEXITY_API_KEY=

# Modelo usado para generar respuestas fundamentadas en busquedas web.
PERPLEXITY_MODEL=sonar

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
# URL del servicio de base de datos vectorial. Esta variable es obligatoria.
QDRANT_URL=http://localhost:6333

# Clave de acceso a Qdrant. Puede dejarse vacia si la instancia no la requiere.
QDRANT_API_KEY=tu_qdrant_key_si_tiene

# Numero maximo de resultados vectoriales recuperados por consulta.
QDRANT_VECTOR_LIMIT=3

# Numero maximo de puntos cargados al recorrer una coleccion.
QDRANT_MAX_SCROLL_POINTS=5000

# -----------------------------------------------------------------------------
# Limites de conversaciones y contexto
# -----------------------------------------------------------------------------
# Longitud maxima permitida para el prompt enviado por el usuario, en caracteres.
MAX_PROMPT_LENGTH=4000

# Numero maximo de mensajes previos incluidos como historial de conversacion.
MAX_HISTORY_MESSAGES=12

# Longitud maxima permitida para el titulo de una conversacion, en caracteres.
MAX_CONVERSATION_TITLE_LENGTH=80

# Tamano maximo del contexto documental enviado al modelo, en caracteres.
MAX_CONTEXT_CHARS=18000

# -----------------------------------------------------------------------------
# Cache de colecciones Qdrant
# -----------------------------------------------------------------------------
# Tiempo durante el que una coleccion permanece en cache, en milisegundos.
CACHE_TTL_MS=600000

# Numero maximo de colecciones conservadas simultaneamente en cache.
CACHE_MAX_COLLECTIONS=10

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Duracion de la ventana de limitacion de peticiones, en milisegundos.
RATE_LIMIT_WINDOW_MS=60000

# Numero maximo de peticiones aceptadas por IP durante cada ventana.
RATE_LIMIT_MAX=30
